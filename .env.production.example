# SmartAid AI — Root Docker Compose Production Environment Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env in the project root to supply variables to docker-compose.yml.
# NEVER commit your production .env with real credentials to source control.
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_USER=smartaid_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=smartaid
POSTGRES_PORT=5432

# Backend Application Configuration
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX_KEY
APP_BASE_URL=https://smartaid.app
ALLOWED_ORIGINS=https://smartaid.app,http://localhost:8080
BACKEND_PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=1440
