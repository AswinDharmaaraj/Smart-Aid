# SmartAid AI — Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual local/production settings.
# NEVER commit the actual .env file or production secret keys to version control.

# Authentication & Security
SECRET_KEY=replace-with-a-secure-random-64-character-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartaid

# Application & QR Destination URL
APP_BASE_URL=http://localhost:8080

# CORS Allowed Origins (Comma-separated or JSON array)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080

# Hospital Geodata Provider Configuration
HOSPITAL_PROVIDER=nominatim
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=SmartAidAcademicProject/1.0 (smartaid-project@college.edu)
HOSPITAL_TIMEOUT_SECONDS=10
ENABLE_LOCAL_OSM_FALLBACK=True
LOCAL_OSM_DATASET_PATH=app/data/osm_hospitals_reference.json

# Overpass API (Alternative Provider)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=15
