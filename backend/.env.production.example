# SmartAid AI — Backend Production Environment Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env on the production host or configure these environment
#    variables in your container orchestrator (Docker Compose, ECS, Kubernetes, etc.).
# 2. NEVER commit actual production secrets or database credentials to Git.
# ==============================================================================

# ── 1. Security & Authentication ──────────────────────────────────────────────
# Generate a random 64-character secret using: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 2. Production PostgreSQL Connection ──────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# In Docker Compose, the database host is typically 'db'
DATABASE_URL=postgresql://smartaid_user:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/smartaid

# ── 3. Application & QR Destination URL ───────────────────────────────────────
# The public canonical URL of the application used when encoding dynamic QR codes
APP_BASE_URL=https://smartaid.app

# ── 4. CORS Allowed Origins ───────────────────────────────────────────────────
# Comma-separated list of trusted origins permitted to make cross-origin requests
ALLOWED_ORIGINS=https://smartaid.app,https://admin.smartaid.app

# ── 5. Hospital Locator Geodata Providers ─────────────────────────────────────
# Provider options: "nominatim" (default), "overpass", "local_osm"
HOSPITAL_PROVIDER=nominatim
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=SmartAidProductionSystem/1.0 (contact@smartaid.app)
HOSPITAL_TIMEOUT_SECONDS=10
ENABLE_LOCAL_OSM_FALLBACK=True
LOCAL_OSM_DATASET_PATH=app/data/osm_hospitals_reference.json

# Alternative provider fallback configuration
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=15
